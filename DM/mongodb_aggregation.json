/* retrieve the number of movies of each actor */
db.movie.aggregate(
	[
		{ "$unwind": "$crew" },
		{ "$match": { "crew.role": "actor" } },
		{ "$group": { "_id": { "person_id": "$crew.person_id", "given_name": "$crew.given_name"}, 
			"movie_participations": { "$sum": 1 } } }
	])



/* retrieve the actors that participated to more than 10 movies */
db.movie.aggregate(
	[
		{ "$unwind": "$crew" },
		{ "$match": { "crew.role": "actor" } },
		{ "$group": { "_id": { "person_id": "$crew.person_id", "given_name": "$crew.given_name"}, 
			"movie_participations": { "$sum": 1 } } },
		{ "$match": { "movie_participations": { "$gt": 10 } } }
	])


/* retrieve the whole number of ratings provided in 2017 */



/* For each person in the crew, return their name and an array of movies they worked on. Each array entry should include the movie title, year, role, and character when available. */
/* { "allowDiskUse": true } is inserted as a second parameter of the pipeline to enable the use of the disk when the amount of memory of the query exceeds the max */
db.movie.aggregate(
	[
		{ "$unwind": "$crew" },
		{ "$sort": { "year": 1 } },
		{ "$group": { "_id": {"person_id": "$crew.person_id", "given_name": "$crew.given_name"}, "movies": { "$push": { "title": "$title", "year": "$year", "role": "$crew.role", "character": "$crew.character" } } } }
	], { "allowDiskUse": true } )


/* For each crew record, add a field called contribution. Set it to "acting" if the person is an actor, and "behind the scenes" otherwise. Show the character only for actors. */
db.movie.aggregate(
	[
		{"$unwind": "$crew"},
		{ "$set": { 
			"contributions": {
				"$cond": [ { "$eq": [ "$crew.role", "actor" ] }, "acting", "behind the scenes" ] } ,
			"character_name": { 
				"$cond": [ { "$eq": [ "$crew.role", "actor" ] }, "$crew.character", null ] }
		} }
	])

