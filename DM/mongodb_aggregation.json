/* For each movie, return its title and an array containing the name and role of every crew member. */
db.movie.aggregate(
	[
		{ "$unwind": "$crew" },
		{ "$group": { "_id": { "id": "$_id", "title": "$title" }, "crew_members": { "$push": { "person_id": "$crew.person_id", "name": "$crew.given_name", "role": "$crew.role" } } } }
	])


/* For each movie, return its title and an array containing the name of the directors */
db.movie.aggregate(
	[
		{ "$unwind": "$crew" },
		{ "$match": { "crew.role": "director" } },
		{ "$group": { "_id": { "id": "$_id", "title": "$title" }, "directors": { "$push": { "person_id": "$crew.person_id", "name": "$crew.given_name" } } } }
	])


